# Copy this file to .env and edit it. Never commit .env (it holds your keys).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nexus

# ---- Language model: choose ONE setup ------------------------------------------------
# A) Local, free and private (default): Ollama
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# OLLAMA_URL=http://localhost:11434
# CHAT_MODEL=llama3.1:8b        # optional: a stronger model just for general chat

# B) Any OpenAI-compatible service (OpenAI, Groq, OpenRouter, Together, LM Studio, vLLM ...)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1     # Groq: https://api.groq.com/openai/v1
#                                            # OpenRouter: https://openrouter.ai/api/v1
#                                            # LM Studio: http://localhost:1234/v1
# LLM_API_KEY=your-key-here
# LLM_MODEL=gpt-4o-mini                      # answers from documents (short, temperature 0)
# CHAT_MODEL=gpt-4o                          # general chat (optional, defaults to LLM_MODEL)

# ---- Chat tuning (optional) -------------------------------------------------------------
# CHAT_MAX_TOKENS=800
# CHAT_TEMPERATURE=0.7
# CHAT_RATE_LIMIT_PER_MIN=30     # all users together; 0 turns the limit off
